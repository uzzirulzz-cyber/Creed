# GEMINI_API_KEY: Optional for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where GameVault is hosted (e.g. http://localhost:3000 on Windows local dev).
APP_URL="http://localhost:3000"

# USD to PKR conversion rate used for local Rapid Gateway & manual PKR totals
USD_TO_PKR_RATE="278.5"

# ElectronicFirst Partner API v1 (Argon / Partner Hub)
ELECTRONICFIRST_API_KEY=""
ELECTRONICFIRST_API_BASE="https://www.electronicfirst.com/partners/api/v1"

# PayPal International Checkout (REST v2 Orders API)
PAYPAL_ENV="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""

# Rapid Gateway Local PKR Checkout (JazzCash / Easypaisa / Bank / Card)
RAPID_ENV="TEST"
RAPID_BASE_URL="https://secure.rapid-gateway.com"
RAPID_MERCHANT_ID=""
RAPID_CLIENT_ID=""
RAPID_CLIENT_SECRET=""
RAPID_SIGNING_SALT=""
